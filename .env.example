# Copy this file to .env and paste your OpenRouter key after the = sign.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="XYZ"
DATABASE_URL=postgresql+asyncpg://synth:YOUR_SYNTH_PASSWORD@localhost:5432/synth

# Which environment this is: dev, staging or prod.
ENVIRONMENT=dev

# Optional overrides (defaults live in core/config.py):
# LLM_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
# Level 3: signs login tokens. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me